<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/group"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_horizontal"
	android:orientation="horizontal">

	<FrameLayout
		android:id="@+id/top_left"
		style="@style/SldRadio"
		android:layout_width="35dp"
		android:layout_height="35dp"
		android:foreground="@drawable/sld_ic_location_top_left" />

	<FrameLayout
		android:id="@+id/top_right"
		style="@style/SldRadio"
		android:layout_width="35dp"
		android:layout_height="35dp"
		android:foreground="@drawable/sld_ic_location_top_right" />

	<FrameLayout
		android:id="@+id/bottom_left"
		style="@style/SldRadio"
		android:layout_width="35dp"
		android:layout_height="35dp"
		android:foreground="@drawable/sld_ic_location_bottom_left" />

	<FrameLayout
		android:id="@+id/bottom_right"
		style="@style/SldRadio"
		android:layout_width="35dp"
		android:layout_height="35dp"
		android:foreground="@drawable/sld_ic_location_bottom_right" />
</LinearLayout>