<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:gravity="top">
		<shape>
			<size android:height="20dp" />
			<gradient
				android:angle="-90"
				android:endColor="#0000"
				android:startColor="#cfff" />
		</shape>
	</item>
	<item android:gravity="bottom">
		<shape>
			<size android:height="20dp" />
			<gradient
				android:angle="90"
				android:endColor="#0000"
				android:startColor="#cfff" />
		</shape>
	</item>
</layer-list>